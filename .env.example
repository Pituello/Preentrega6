# copiar a .env y completar

# --- LLM (obligatorio: una key, o Ollama local) ---
# Valores de LLM_PROVIDER: openai, anthropic, gemini, ollama. Si está vacío, se usa la
# primera key cargada (OpenAI, Anthropic, Gemini). Ollama solo con LLM_PROVIDER=ollama.
# demo.py hace ~60 llamadas: con gpt-4o-mini cuesta unos centavos; la capa gratuita de
# Gemini (20 pedidos por día) no alcanza para la corrida completa.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# modelos por defecto: gpt-4o-mini / claude-sonnet-4-6 / gemini-flash-latest / llama3.2
# OPENAI_MODEL=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0

# --- Orquestador ---
# Intervenciones máximas de especialistas por tarea (evita el "supervisor infinito")
MAX_PASOS=8
# Reparaciones por especialista antes de escalar a revisión humana
MAX_REPARACIONES=2
# Techo de pasos de LangGraph (cada vuelta especialista -> validador -> supervisor usa 3)
RECURSION_LIMIT=40

# --- Búsqueda en las fichas técnicas ---
# local: BM25 sobre data/ (default). pinecone: BM25 + índice de la Pre-Entrega 4 (RRF);
# requiere requirements-pinecone.txt y estas variables:
BUSQUEDA_BACKEND=local
PINECONE_API_KEY=
INDEX_NAME=volkswagen-rag-hibrido
NAMESPACE=vw-modelos-dev

DATA_DIR=data
TRAZAS_DIR=trazas
